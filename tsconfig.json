{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "Node",

        "rootDir": "src",
        "outDir": "dist",

        "declaration": true,
        "declarationMap": true,

        "strict": true,

        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,

        "skipLibCheck": true,

        "forceConsistentCasingInFileNames": true,

        "sourceMap": true,

        "types": [
            "node"
        ]
    },

    "include": [
        "src/**/*.ts"
    ],

    "exclude": [
        "node_modules",
        "dist"
    ]
}